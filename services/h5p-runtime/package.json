{
  "name": "@learners-hub/h5p-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated self-hosted H5P package importer and learner player.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node build/index.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lumieducation/h5p-express": "10.0.5",
    "@lumieducation/h5p-server": "10.0.4",
    "express": "4.22.2",
    "helmet": "8.3.0"
  },
  "devDependencies": {
    "@types/express": "4.17.23",
    "@types/node": "22.19.19",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "path-to-regexp": "0.1.13",
    "qs": "6.15.3",
    "underscore": "1.13.8"
  }
}
