# Public HTTPS origin of the H5P runtime deployed on the Hostinger VPS.
H5P_RUNTIME_BASE_URL=https://h5p.example-school.com

# Generate a unique value with at least 32 random characters.
H5P_RUNTIME_SHARED_SECRET=replace-with-a-long-random-secret

# Standard Node/VPS authentication and PostgreSQL.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://learners_hub:password@localhost:5432/learners_hub

# Where uploaded lesson media is stored. Set on the Node/VPS deployment, where
# there is no Cloudflare R2 binding; the Docker image already defaults it to
# /data/media on a mounted volume. Leave unset on Cloudflare so the R2 binding
# is used instead.
MEDIA_STORAGE_DIR=./.media
# Outgoing mail. Leave SMTP_URL unset and nothing is sent — messages are
# written to the log instead, so admissions still works on a box where mail was
# never configured. Any SMTP provider works; the school's own mailbox is
# usually the right one, so replies reach a person.
#   smtps://admissions%40school.edu.gh:app-password@smtp.hostinger.com:465
SMTP_URL=
MAIL_FROM=Greenfield Academy <admissions@example-school.com>
# Where new applications are announced. Falls back to INITIAL_ADMIN_EMAIL.
ADMISSIONS_INBOX=admissions@example-school.com

# Two-factor sign-in. The plugin is always on and anybody may enrol at
# /account/security. This switch decides whether a school and academic admin
# who has NOT enrolled is stopped or only asked.
#
# Leave it off while a school is being set up: enforcing it before its
# administrators have enrolled locks them out of their own school, and there
# is no support desk behind this product. Turn it on once they have.
TWO_FACTOR_ENFORCED=false

# Virus scanning for uploads, over clamd's INSTREAM protocol. Unset and
# uploads are checked against their file signature only — which catches a
# renamed executable but not a known threat. /api/health reports which.
#   CLAMAV_HOST=127.0.0.1
CLAMAV_HOST=
CLAMAV_PORT=3310

# Shared secret for the abandoned-draft reminder job. Unset means the endpoint
# refuses to run at all, rather than sitting open for anyone to trigger:
#   0 9 * * * curl -fsS -X POST https://<host>/api/admissions/reminders \
#               -H "authorization: Bearer $ADMISSIONS_REMINDER_SECRET"
ADMISSIONS_REMINDER_SECRET=

# The school this deployment serves. SCHOOL_NAME only names the tenant row the
# first time it is created — after that the school renames itself on
# /admin/school and that edit wins. SCHOOL_TENANT_ID defaults to
# "tenant-greenfield" so an existing box keeps its rows; leave it alone unless
# you are standing up a new deployment and want an id of your own.
SCHOOL_NAME=Your School
# SCHOOL_TENANT_ID=tenant-greenfield

INITIAL_ADMIN_EMAIL=admin@example-school.com
INITIAL_ADMIN_NAME=School Administrator
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# The Greenfield Academy demo school: its staff and learners, four subjects, a
# term of lessons, a question bank, a published paper with a marked attempt, a
# markbook, a timetable, a register and a released report card.
#
# Leave it off in production. A real school with this on shares its directory
# with a cast it has never met and its markbook with somebody else's marks.
DEMO_SCHOOL=false

# Sign-in identities for that cast — a teacher, a learner, their guardian, an
# academic administrator and an admissions officer — plus a submitted
# application in the review queue. Implies DEMO_SCHOOL, because the accounts
# attach to its person rows.
#
# Only safe on a staging box you are willing to have anyone sign into: the
# password is shared and the addresses are in the repository. See
# docs/demo-walkthrough.md.
DEMO_ACCOUNTS=false
DEMO_PASSWORD=
