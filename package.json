{
  "name": "learners-hub-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:domain && npm run test:runtime",
    "test:domain": "vitest run --config vitest.config.ts",
    "test:runtime": "npm --prefix services/h5p-runtime test",
    "typecheck": "npm run typecheck:web && npm --prefix services/h5p-runtime run typecheck",
    "typecheck:web": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern services/h5p-runtime/build --ignore-pattern services/h5p-runtime/node_modules",
    "db:generate": "drizzle-kit generate",
    "schema:generate": "tsx scripts/generate-learning-schema.ts"
  },
  "dependencies": {
    "better-auth": "^1.6.25",
    "canvas-confetti": "^1.9.4",
    "drizzle-orm": "0.45.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "type": "module"
}
